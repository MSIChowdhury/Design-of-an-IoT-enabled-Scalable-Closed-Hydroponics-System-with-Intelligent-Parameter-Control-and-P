\begin{tikzpicture}[node distance=10mm and 13mm]
\tikzset{
  block/.style={rectangle, rounded corners=2pt, draw=black!70, line width=0.6pt,
    minimum width=26mm, minimum height=9mm, align=center, font=\scriptsize, inner sep=3pt},
  input/.style={block, fill=blue!10, draw=blue!60!black},
  module/.style={block, fill=orange!14, draw=orange!70!black},
  output/.style={block, fill=green!14, draw=green!55!black},
  danger/.style={block, fill=red!9, draw=red!70!black},
  flow/.style={-{Stealth[length=2mm,width=1.5mm]}, line width=0.65pt, draw=black!75},
  suppress/.style={-{Stealth[length=2mm,width=1.5mm]}, dashed, line width=0.65pt, draw=red!70!black},
  note/.style={font=\tiny, align=center, text=black!70}
}

\node[input] (raw) {Raw sample\\$y_s(t)$};
\node[module, right=of raw] (gate) {Range/rate\\gates};
\node[module, right=of gate] (trust) {Trust score\\$q_s(t)$};
\node[module, below=of trust] (state) {Persistence\\state $z_s(t)$};
\node[module, left=of state] (rect) {Rectified state\\$\hat{x}_s(t)$};
\node[output, left=of rect] (auth) {Actuation\\authorization};
\node[output, below=of auth] (act) {Controller\\and actuator};
\node[module, below=of rect] (response) {Response\\residual $G^{AR}_s$};
\node[danger, below=of state] (reject) {Log, hold,\\or alert};

\draw[flow] (raw) -- (gate);
\draw[flow] (gate) -- node[note, above] {$g_s(t)$} (trust);
\draw[flow] (trust) -- (state);
\draw[flow] (state) -- (rect);
\draw[flow] (rect) -- (auth);
\draw[flow] (auth) -- node[note, left] {$A_s(t)=1$} (act);
\draw[flow] (act.east) -- node[note, below] {observed response} (response.west);
\draw[flow] (response) -- node[note, right] {$\eta_s(t)$} (state);
\draw[suppress] (gate.south) to[out=-75,in=125] node[note, pos=0.35, right] {reject} (reject.north);
\draw[suppress] (state) -- node[note, right] {suspect/fault} (reject);
\draw[suppress] (response) -- node[note, below] {failed response} (reject);
\draw[suppress] (reject.west) -| node[note, pos=0.20, below] {$A_s(t)=0$} (auth.south);
\end{tikzpicture}
