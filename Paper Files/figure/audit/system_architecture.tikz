\begin{tikzpicture}[node distance=14mm and 15mm]
\tikzset{
  block/.style={rectangle, rounded corners=2pt, draw=black!70, line width=0.6pt,
    text width=35mm, minimum height=12mm, align=center, font=\small, inner sep=3pt},
  process/.style={block, fill=green!7, draw=green!55!black},
  sense/.style={block, fill=blue!10, draw=blue!60!black},
  compute/.style={block, fill=orange!14, draw=orange!70!black},
  guard/.style={block, fill=yellow!16, draw=yellow!45!black},
  act/.style={block, fill=red!8, draw=red!70!black},
  data/.style={block, fill=gray!10, draw=black!50},
  flow/.style={-{Stealth[length=2mm,width=1.5mm]}, line width=0.65pt, draw=black!75},
  stop/.style={-{Stealth[length=2mm,width=1.5mm]}, dashed, line width=0.65pt, draw=red!70!black},
  lab/.style={font=\scriptsize, align=center, fill=white, inner sep=2pt}
}

\node[process] (hydro) {Closed NFT\\hydroponic system};
\node[sense, above=of hydro] (sensors) {pH, EC, CO$_2$,\\temperature, humidity};
\node[compute, right=of sensors] (nano) {Arduino Nano\\sensor acquisition};
\node[guard, right=of nano] (pi) {Raspberry Pi 4B\\gate + controller};
\node[compute, below=of pi] (mega) {Arduino Mega\\actuator interface};
\node[act, left=of mega] (actuators) {Dosing, cooling,\\gas, circulation};
\node[data, above=of pi] (log) {ThingSpeak feed\\audited sensor log};

\draw[flow] (hydro) -- node[lab, left] {sensing} (sensors);
\draw[flow] (sensors) -- node[lab, above] {readings} (nano);
\draw[flow] (nano) -- node[lab, above] {samples} (pi);
\draw[flow] (pi) -- node[lab, right] {commands} (mega);
\draw[flow] (mega) -- node[lab, above] {outputs} (actuators);
\draw[flow] (actuators.west) -- node[lab, above] {physical\\effect} (hydro.east);
\draw[flow] (pi) -- node[lab, right] {about 16 s} (log);
\node[font=\small, align=center, below=8mm of actuators]
  {Command and relay states were not logged.};
\end{tikzpicture}
