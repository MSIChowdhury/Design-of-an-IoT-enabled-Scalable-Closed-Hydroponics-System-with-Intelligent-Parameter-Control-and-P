# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Generated local data and results
data/raw/**/*
data/interim/**/*
data/processed/**/*
data/synthetic/**/*
results/metrics/**/*
results/tables/**/*
results/figures/**/*
results/run_metadata/**/*
results/run_logs/**/*

# Keep placeholders and documentation
!data/raw/**/
!data/interim/**/
!data/processed/**/
!data/synthetic/**/
!data/**/.gitkeep
!data/README.md
# Agronomic harvest sheets are publicly shareable (sensor log stays request-only)
!data/raw/hydroponic/Agronomic Data.csv
!data/raw/hydroponic/Lettuce Agronomic and Nutritional Data - 1st Trial Agronomic Data for ANOVA.csv
!results/metrics/**/
!results/tables/**/
!results/figures/**/
!results/run_metadata/**/
!results/**/.gitkeep
!results/README.md

# Keep nested raw-data repositories out of the parent repository status.
data/raw/*/*_repo/
data/raw/**/hai_repo/
data/raw/**/.git/

# Logs and local environments
*.log
.env
.venv/
venv/

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.lof
*.lot
*.out
*.run.xml
*.spl
*.synctex.gz
*.toc

# Credential files
Code Files/Web Interface/*.json
